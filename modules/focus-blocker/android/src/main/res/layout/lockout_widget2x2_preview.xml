<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lockout_widget_preview_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Lockout"
        android:src="@drawable/lockout_widget_preview_icon" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="TODAY"
            android:textColor="@color/lockout_widget_preview_subtext"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="4h 0m"
            android:textColor="@color/lockout_widget_preview_text"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="focused today"
            android:textColor="@color/lockout_widget_preview_subtext"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/lockout_widget_preview_badge_bg"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="9dp"
            android:paddingTop="3dp"
            android:paddingRight="9dp"
            android:paddingBottom="3dp"
            android:text="8 day streak"
            android:textColor="@color/lockout_widget_preview_badge_text"
            android:textSize="10.5sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/lockout_widget_preview_button_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Start 25m"
        android:textColor="@color/lockout_widget_preview_button_text"
        android:textSize="13sp" />

</LinearLayout>
