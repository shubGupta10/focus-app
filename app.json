{
  "expo": {
    "name": "Lockout",
    "slug": "lockout",
    "owner": "shubham720",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#161517"
      },
      "package": "com.shubham720.lockout",
      "versionCode": 27,
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidDependenciesInfo",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F4",
          "image": "./assets/images/splash-image.png",
          "dark": {
            "backgroundColor": "#161517",
            "image": "./assets/images/splash-image.png"
          },
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "3.31.6",
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.focusblocker.** { *; }\n-keepclassmembers class expo.modules.focusblocker.** { *; }\n-keepclassmembernames class expo.modules.focusblocker.** { *; }\n-keep class expo.modules.** { *; }\n-keep interface expo.modules.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod\n-dontwarn **"
          }
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "LockoutWidget4x2",
              "displayName": "Lockout",
              "description": "View focus streak and active session",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 245,
                "minHeight": 115,
                "initialLayout": "./src/widgets/LockoutWidget4x2.tsx"
              }
            },
            {
              "name": "LockoutWidget2x2",
              "displayName": "Lockout (Small)",
              "description": "Compact focus streak and timer",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "initialLayout": "./src/widgets/LockoutWidget2x2.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withWidgetStartAction"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93ede2bb-c65f-403d-ba1a-2b20d0348b72"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93ede2bb-c65f-403d-ba1a-2b20d0348b72",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}